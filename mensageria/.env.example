# mesmo banco da api, em formato de url (o que o psycopg entende)
BANCO_URL=postgresql://postgres:postgres@localhost:5432/livros_pi

# cadeia de conexao da politica sas da fila (portal do azure > fila > politicas de acesso compartilhado)
# nunca versionar o valor real: ele fica so no mensageria/.env
SERVICE_BUS_CONEXAO=

# nome da fila; se a cadeia de conexao tiver EntityPath, ele tem prioridade
SERVICE_BUS_FILA=nextread-recomendacoes
