# mesmo banco da api, mas em formato de url (o que o psycopg entende).
# a api em c# usa Host=...;Database=...;Username=... no appsettings.json
BANCO_URL=postgresql://postgres:postgres@localhost:5432/livros_pi

# caminho do csv usado na ingestao
CAMINHO_DATASET=../BooksDataset.csv

# onde o modelo tf-idf treinado e salvo
DIRETORIO_ARTEFATOS=./artefatos

# quantos similares por livro o treino persiste
TOTAL_RECOMENDACOES=10
