# conexao com o postgres do projeto
BANCO_URL=postgresql+psycopg://postgres:postgres@localhost:5432/livros_pi

# caminho do csv usado na ingestao
CAMINHO_DATASET=../BooksDataset.csv

# onde o modelo tf-idf treinado e salvo
DIRETORIO_ARTEFATOS=./artefatos

# quantas recomendacoes o endpoint devolve por padrao
TOTAL_RECOMENDACOES=10

# paginacao
TAMANHO_PAGINA_PADRAO=20
TAMANHO_PAGINA_MAXIMO=100

# loga o sql gerado pelo sqlalchemy
ECO_SQL=false
